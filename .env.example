# FlowForge LLM Gateway Configuration
# Copy to .env and fill in your values

# Required: Auth token for the LLM gateway
ANTHROPIC_AUTH_TOKEN=sk-your-token-here

# Gateway base URL (defaults to internal corporate gateway)
ANTHROPIC_BASE_URL=https://eng-ai-model-gateway.sfproxy.devx-preprod.aws-esvc1-useast2.aws.sfdc.cl

# Model to use (short aliases supported: claude-sonnet, claude-haiku, claude-opus)
FLOWFORGE_MODEL=claude-sonnet

# TLS certificate for corporate gateway (optional, auto-detected)
# SSL_CERT_FILE=~/.aisuite/conf/npm-sfdc-certs.pem
