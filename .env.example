# FlowStrix — Environment Configuration
# Copy this to .env and fill in your values
#
# Provider fallback order: Together AI -> Groq -> Gemini -> Anthropic.
# Set as many as you have keys for — ChatGateway tries them in this order and
# automatically fails over on a rate-limit or provider error.

# ─────────────────────────────────────────────────
# Option 1: Together AI API Key (Recommended — default/primary, metered
# paid tier, no free-tier rate-limit throttling)
# Get a key at https://api.together.ai
# ─────────────────────────────────────────────────
TOGETHER_API_KEY=your_together_api_key_here

# ─────────────────────────────────────────────────
# Option 2: Groq API Key (first fallback)
# Get a free key at https://console.groq.com
# ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ─────────────────────────────────────────────────
# Option 3: Gemini API Key (second fallback)
# Get a free key at https://aistudio.google.com
# ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────
# Option 4: Anthropic API Key (third fallback — most expensive, last resort)
# Get a key at https://console.anthropic.com
# ─────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─────────────────────────────────────────────────
# Optional: Model override
# If Together AI:
#   qwen-7b            → Qwen/Qwen2.5-7B-Instruct-Turbo (default)
#   together-llama-70b → meta-llama/Llama-3.3-70B-Instruct-Turbo
#
# If Groq:
#   llama-70b    → llama-3.3-70b-versatile
#   llama-8b     → llama-3.1-8b-instant
#
# If Gemini:
#   gemini-flash → gemini-3.5-flash (default, fast & smart)
#   gemini-pro   → gemini-3.5-pro   (best reasoning)
#
# If Anthropic:
#   claude-sonnet → claude-sonnet-5
#   claude-opus   → claude-opus-4-8
#   claude-haiku  → claude-haiku-4-5-20251001
# ─────────────────────────────────────────────────
# FLOWSTRIX_MODEL=qwen-7b

# ─────────────────────────────────────────────────
# Optional: Upstash Redis (exact-match response cache)
# Get a free database at https://upstash.com
# When set, repeated demo prompts (hardcoded step prompts clicked by
# recruiters) are served from cache instead of hitting the LLM.
# ─────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
