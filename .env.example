# FlowStrix — Environment Configuration
# Copy this to .env and fill in your values

# ─────────────────────────────────────────────────
# Option 1: Gemini API Key (Recommended)
# Get a free key at https://aistudio.google.com
# ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────
# Option 2: Groq API Key
# Get a free key at https://console.groq.com
# ─────────────────────────────────────────────────
# GROQ_API_KEY=gsk_your_key_here

# ─────────────────────────────────────────────────
# Optional: Model override
# If Gemini:
#   gemini-flash → gemini-2.5-flash (default, fast & smart)
#   gemini-pro   → gemini-2.5-pro   (best reasoning)
#
# If Groq:
#   llama-70b    → llama-3.3-70b-versatile
#   llama-8b     → llama-3.1-8b-instant
# ─────────────────────────────────────────────────
# FLOWSTRIX_MODEL=gemini-flash
